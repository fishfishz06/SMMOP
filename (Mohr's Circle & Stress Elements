            </div>
            
            <div class="flex items-center gap-3">
                <div class="hidden sm:flex items-center space-x-2 text-xs bg-slate-950/80 px-3.5 py-1.5 rounded-lg border border-slate-800/80">
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-300 font-medium">慣用符號：拉應力向右 (+) | 逆時針剪應力向上 (+)</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-[1600px] w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Left Column: Inputs & Controls (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
            
            <!-- Inputs Box -->
            <div class="bg-slate-900/80 border border-slate-800/90 rounded-2xl p-5 shadow-2xl backdrop-blur-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/5 rounded-full blur-2xl pointer-events-none"></div>
                <h2 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-4 flex items-center justify-between">
                    <span class="flex items-center gap-2"><i class="fa-solid fa-sliders"></i> 應力與旋轉角度輸入</span>
                    <span class="text-[10px] text-slate-500 font-normal">單位：MPa / deg</span>
                </h2>

                <div class="space-y-4 text-xs">
                    <!-- σx -->
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="font-medium text-slate-300 flex items-center gap-1.5" for="input-sx">
                                <span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block"></span>
                                正向應力 &sigma;<sub>x</sub>
                            </label>
                            <span id="val-sx" class="mono text-rose-400 font-semibold">100.0</span>
                        </div>
                        <input type="range" id="slider-sx" min="-1000" max="1000" step="5" value="100" class="w-full accent-rose-500 cursor-pointer">
                        <input type="number" id="input-sx" value="100" class="mt-1 w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-white mono focus:outline-none focus:border-rose-500">
                    </div>

                    <!-- σy -->
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="font-medium text-slate-300 flex items-center gap-1.5" for="input-sy">
                                <span class="w-2.5 h-2.5 rounded-full bg-sky-400 inline-block"></span>
                                正向應力 &sigma;<sub>y</sub>
                            </label>
                            <span id="val-sy" class="mono text-sky-400 font-semibold">-500.0</span>
                        </div>
                        <input type="range" id="slider-sy" min="-1000" max="1000" step="5" value="-500" class="w-full accent-sky-500 cursor-pointer">
                        <input type="number" id="input-sy" value="-500" class="mt-1 w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-white mono focus:outline-none focus:border-sky-500">
                    </div>

                    <!-- τxy -->
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="font-medium text-slate-300 flex items-center gap-1.5" for="input-txy">
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block"></span>
                                剪應力 &tau;<sub>xy</sub>
