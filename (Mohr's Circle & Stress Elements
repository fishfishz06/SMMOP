                            <span id="val-txy" class="mono text-amber-400 font-semibold">-400.0</span>
                        </div>
                        <input type="range" id="slider-txy" min="-1000" max="1000" step="5" value="-400" class="w-full accent-amber-500 cursor-pointer">
