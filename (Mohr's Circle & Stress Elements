                            <div>&sigma;<sub>x'</sub> = <span id="e2-sx" class="text-purple-300 font-semibold">196.4</span> MPa</div>
                            <div>&sigma;<sub>y'</sub> = <span id="e2-sy" class="text-pink-300 font-semibold">-596.4</span> MPa</div>
                            <div>&tau;<sub>x'y'</sub> = <span id="e2-txy" class="text-amber-300 font-semibold">-459.8</span> MPa</div>
