                    <!-- Element 2: Rotated Element by θ -->
                    <div class="bg-slate-950 border border-purple-900/50 rounded-xl p-3 flex flex-col justify-between">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-xs font-semibold text-purple-400 flex items-center gap-1">
                                <i class="fa-solid fa-rotate text-[10px]"></i> 2. 旋轉 &theta; 應力元素
                            </span>
                            <span id="e2-theta-tag" class="text-[10px] mono text-purple-300 font-semibold">&theta; = 30.0°</span>
