                    <!-- Element 3: Principal Stress Element by θp -->
                    <div class="bg-slate-950 border border-emerald-900/50 rounded-xl p-3 flex flex-col justify-between">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1">
