            <!-- 3 Physical Stress Elements Visualization Block -->
            <div class="bg-slate-900/90 border border-slate-800/90 rounded-2xl p-4 shadow-2xl space-y-3">
                <div class="flex flex-wrap justify-between items-center px-1 border-b border-slate-800/80 pb-2.5">
