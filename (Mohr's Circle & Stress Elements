                            </span>
                            <span id="e3-thetap-tag" class="text-[10px] mono text-emerald-300 font-semibold">&theta;p = -26.6°</span>
                        </div>
                        <div class="w-full h-[180px] relative">
                            <canvas id="elemCanvasPrincipal" class="w-full h-full block"></canvas>
                        </div>
                        <div class="text-[10px] text-slate-400 mono border-t border-slate-800/80 pt-1.5 space-y-0.5">
                            <div>&sigma;<sub>1</sub> = <span id="e3-s1" class="text-emerald-400 font-semibold">300.0</span> MPa</div>
                            <div>&sigma;<sub>2</sub> = <span id="e3-s2" class="text-teal-400 font-semibold">-700.0</span> MPa</div>
                            <div>&tau;<sub>max</sub> = <span class="text-slate-500 font-semibold">0.0</span> MPa (主平面無剪力)</div>
                        </div>
                    </div>

                </div>
            </div>

